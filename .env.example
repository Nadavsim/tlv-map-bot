# MongoDB Atlas connection string (free M0 cluster - see README for setup)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=tlvbot

# Your Google My Maps map's ID (the "mid=" value in the map's share URL).
# The map must be shared as "Anyone with the link can view" for this to work.
MYMAPS_ID=your_mymaps_id_here
# Alternative: set the full KML export URL directly instead of MYMAPS_ID.
# MYMAPS_KML_URL=https://www.google.com/maps/d/kml?mid=your_mymaps_id_here&forcekml=1

# Anthropic API key (used for parsing free-text food requests, claude-haiku-4-5)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Sign-In. GOOGLE_CLIENT_ID is a Web application OAuth Client ID from
# Google Cloud Console (APIs & Services > Credentials) - not secret, it ends
# up in the frontend's own public code either way. JWT_SECRET signs this
# app's own access/refresh tokens and IS secret - generate a random one, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`, and use a
# different value per environment (dev/staging/production).
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
JWT_SECRET=a_long_random_secret_here
