# Inside .gitignore

# Secrets
.env

# Python Virtual Environments
venv/
env/
__pycache__/
*.pyc
.pytest_cache/

# OS generated files
.DS_Store

# (Optional) Ignore your map files if you want to keep your favorite spots private
map.kml
cleaned_places.csv

# Frontend build output - generated by `npm run build` inside frontend/
# (see frontend/vite.config.ts, outDir: '../static'). CI builds this fresh
# before deploying; source lives in frontend/src, not here.
/static/

# Node
frontend/node_modules/

# Local tooling (design/agent skills, their hooks and locks, per-machine
# settings): installed per developer, not part of the app.
.agents/
.claude/agents/
.claude/skills/
.claude/settings.local.json
.codex/
.github/agents/
.github/hooks/
.github/skills/
.impeccable/
skills-lock.json
